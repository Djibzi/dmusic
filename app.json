{
  "expo": {
    "name": "DMusic",
    "slug": "dmusic",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dmusic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.dmusic.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppleMusicUsageDescription": "DMusic accède à ta bibliothèque Apple Music locale pour lire tes morceaux téléchargés.",
        "NSDocumentsFolderUsageDescription": "DMusic lit les fichiers audio que tu importes.",
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.dmusic.app"
        ]
      }
    },
    "android": {
      "package": "com.dmusic.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-av",
      "expo-media-library",
      "expo-document-picker",
      "@bacons/apple-targets",
      "./plugins/withAlternateIcons",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "341f6a76-d3a7-4210-a6e0-198711485090"
      }
    }
  }
}
